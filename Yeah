local function CreateR6Template() -- (kept from original API surface)
	local m = Instance.new("Model")
	Instance.new("Humanoid", m)
	local root = Instance.new("Part"); root.Name="HumanoidRootPart"; root.Size=Vector3.new(2,2,1)
	root.Anchored, root.Transparency = true, 1; root.Parent=m; m.PrimaryPart=root
	for n,p in pairs(R6Map) do
		local pt = Instance.new("Part"); pt.Name=n; pt.Size=p.Size
		pt.CFrame=root.CFrame*p.Offset; pt.Anchored=true; pt.Transparency=1; pt.Parent=m
	end
	for n,j in pairs(R6Joints) do
		local mo=Instance.new("Motor6D"); mo.Name=n; mo.C0=j.C0; mo.C1=j.C1
		mo.Part0=m[j.Part0]; mo.Part1=m[j.Part1]; mo.Parent=m[j.Part0]
	end
	return m
end

local function ParseCharacter(char, dataName)
	local pd = Function.PlayerDataAdd(dataName)
	for _, v in ipairs(char:GetChildren()) do
		if v:IsA("BasePart") and v.Name ~= "Head" then
			v.Transparency = 1
			table.insert(pd.HiddenVanilla, v)
		end
	end
	for name, bp in pairs(R6Map) do -- graft missing R6 limbs onto R15
		if not char:FindFirstChild(name) then
			local p = Instance.new("Part")
			p.Name=name; p.Size=bp.Size; p.Transparency=1
			p.CanCollide,p.CanQuery,p.CanTouch,p.Massless=false,false,false,true
			p.Color=char.Head.Color; p.Parent=char
			local sm=Instance.new("SpecialMesh"); sm.MeshId="rbxassetid://12221758"; sm.Parent=p
			if name~="Torso" then sm.Scale=Vector3.new(0.5,1,1) end
			pd.CurrentPartList.Organ[p]=true
			pd.HiddenVanilla[#pd.HiddenVanilla+1] = nil -- grafted parts die with reset
		end
	end
	for name, j in pairs(R6_2_R15) do
		local p0 = char:FindFirstChild(j.Part0); local p1 = char:FindFirstChild(j.Part1)
		if p0 and p1 and not char:FindFirstChild(name) then
			local mo=Instance.new("Motor6D"); mo.Name=name
			mo.C0=j.C0; mo.C1=j.C1 or CFrame.new(); mo.Part0=p0; mo.Part1=p1; mo.Parent=p0
			pd.Conns[#pd.Conns+1]={Instance=mo} -- dies with instance anyway
		end
	end
end

function Function.CharacterReset(char, dataName)
	if not char or not char.Parent then return end
	local pd = PlayerData[dataName]; if not pd then return end
	local plist = pd.CurrentPartList

	for inst in pairs(plist.Organ) do pcall(function() inst:Destroy() end) end
	for inst in pairs(plist.Accessory) do pcall(function() inst:Destroy() end) end
	for decal in pairs(plist.FrostingDecal) do pcall(function() decal:Destroy() end) end
	for inst in pairs(plist.Clothes) do pcall(function() inst:Destroy() end) end
	for _, c in ipairs(pd.StashedClothing) do pcall(function() c.Parent = char end) end

	local morph = char:FindFirstChild("Morph")
	if morph then morph:Destroy() end

	for _, v in ipairs(pd.HiddenVanilla) do
		if v and v.Parent then pcall(function() v.Transparency = 0 end) end
	end

	pd.HiddenVanilla, pd.StashedClothing = {}, {}
	pd.CurrentPartList = Function.PlayerDataDefault().CurrentPartList
	pd.BodyPartPhysicsLive = nil
	pd.deferredWelds = {}
	pd.SquashSpring = Spring.new(Vector3.zero)
	pd.FootAccum, pd.GlitchUntil = 0, 0
end

function Function.CharacterExecute(char, dataName)
	if not char or not char.Parent then return end
	local pd = Function.PlayerDataAdd(dataName)
	if pd.Building then pd.PendingBuild = true; return end
	pd.Building = true

	task.spawn(function()
		local ok, err = pcall(function()
			Function.CharacterReset(char, dataName)
			local morphDef = PART_LISTS[pd.SelectedMorphName] or PART_LISTS.ClemonFemale

			local hum = char:FindFirstChildOfClass("Humanoid")
			local extra = {
				Shirt = char:FindFirstChildOfClass("Shirt"),
				Pants = char:FindFirstChildOfClass("Pants"),
				TShirt = char:FindFirstChildOfClass("ShirtGraphic"),
				UVToggle = pd.UVToggle,
			}
			if morphDef.NoUV then extra.UVToggle = false end

			-- stash real clothes when running mesh mode (restored on reset)
			if not extra.UVToggle then
				for _, c in ipairs({extra.Shirt, extra.Pants, extra.TShirt}) do
					if c then c.Parent = char.PrimaryPart; table.insert(pd.StashedClothing, c) end
				end
			end

			if hum and hum.RigType == Enum.HumanoidRigType.R15 then
				ParseCharacter(char, dataName)
			end

			-- container rig
			local morph = Instance.new("Model")
			morph.Name = "Morph"; morph.Parent = char
			pd.CurrentPartList.Organ[morph] = true

			local function container(name, size)
				local p = Instance.new("Part")
				p.Name=name; p.Size=size; p.Transparency=1
				p.CanCollide,p.CanQuery,p.CanTouch,p.Massless=false,false,false,true
				local w = Instance.new("Weld"); w.Name=name.."_Weld"
				p.Parent = morph
				local src = char:FindFirstChild(name)
				if src then
					w.Part0, w.Part1 = src, p
					p.Color = src.Color
					src.Transparency = 0
					pd.HiddenVanilla[#pd.HiddenVanilla+1] = src
				end
				w.Parent = p
				return p
			end
			container("Torso", Vector3.new(2,2,1))
			container("Right Leg", Vector3.new(1,2,1))
			container("Left Leg", Vector3.new(1,2,1))
			container("Right Arm", Vector3.new(1,2,1))
			container("Left Arm", Vector3.new(1,2,1))

			-- hide the real head if the morph replaces it
			if morphDef.HideHead and char:FindFirstChild("Head") then
				char.Head.Transparency = 1
				pd.HiddenVanilla[#pd.HiddenVanilla+1] = char.Head
				for _, d in ipairs(char.Head:GetChildren()) do
					if d:IsA("Decal") then d.Transparency = 1 end
				end
			end

			-- weld all groups (each isolated — one bad asset can't kill the morph)
			local groups = {"Limbs","Main","Muffins","Donuts"}
			for _, g in ipairs(groups) do
				local grp = morphDef[g]
				if type(grp) == "table" then
					for _, cfg in pairs(grp) do
						if type(cfg)=="table" and cfg.Name then
							if g=="Muffins" and cfg.ScaleKey==nil then cfg.ScaleKey="MuffinsScale" end
							if g=="Donuts"  and cfg.ScaleKey==nil then cfg.ScaleKey="DonutsScale" end
							Function.Weld(cfg, char, extra, dataName)
						end
					end
				end
			end
			if type(morphDef.Tacos) == "table" then
				for _, shellSet in ipairs(morphDef.Tacos) do
					local shell = container("TacoShell", Vector3.new(2,2,1))
					shell.Color = char.Torso.Color
					for _, cfg in pairs(shellSet) do Function.Weld(cfg, char, extra, dataName) end
				end
			end

			-- flush any deferred welds (bounded passes)
			for _ = 1, 5 do
				local remaining = 0
				for root, queue in pairs(pd.deferredWelds) do
					pd.deferredWelds[root] = nil
					remaining += #queue
					for _, cfg in ipairs(queue) do Function.Weld(cfg, char, extra, dataName) end
				end
				if remaining == 0 then break end
			end

			-- READY-UP: seed random offsets that spring-spin home
			pd.ReadyT0 = Clock()
			for inst, entry in pairs(pd.CurrentPartList.RealtimeUpdateList.Mesh) do
				entry.ReadyOff = CFrame.new(
					(math.random()-0.5)*2.4,(math.random()-0.5)*2.4,(math.random()-0.5)*2.4
				) * CFrame.Angles(
					math.rad((math.random()-0.5)*260),
					math.rad((math.random()-0.5)*260),
					math.rad((math.random()-0.5)*260))
			end

			BuildFaceKit(char, pd, morphDef)
			BindCharacterEvents(char, dataName)
			PlaySound("Ping", char.Head or char.PrimaryPart, 1.25)
			PlaySound("Snap", char.Head or char.PrimaryPart, 0.9)
			dprint("Applied '"..pd.SelectedMorphName.."' to "..dataName)
		end)
		if not ok then warnf("CharacterExecute error: "..tostring(err)) end
		pd.Building = false
		if pd.PendingBuild then pd.PendingBuild = false; Function.CharacterExecute(char, dataName) end
	end)
end
