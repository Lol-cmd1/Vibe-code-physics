--#region ██ COMMANDS ██
local RecentCmd = {}
local function DispatchCommand(speakerName, raw)
	raw = raw:gsub("^%s+","")
	if raw:sub(1,1) ~= "/" then return end
	local parts = string.split(raw, " ")
	local cmd = table.remove(parts, 1):lower()
	local arg = parts[1]
	local key = speakerName.."|"..cmd.."|"..(arg or "")
	if RecentCmd[key] and Clock()-RecentCmd[key] < 1 then return end
	RecentCmd[key] = Clock()

	local me = Function.PlayerDataAdd(LocalPlayer.Name)
	local function applySelf() Function.CharacterExecute(LocalPlayer.Character, LocalPlayer.Name) end

	if cmd == "/morph" or cmd == "/execute" then
		if (arg or ""):lower() == "list" then
			print("[Morph] Available: "..table.concat(CONFIG.MorphCycleOrder, ", "))
		elseif arg and PART_LISTS[arg] then
			me.SelectedMorphName = arg; applySelf()
		elseif arg and workspace:FindFirstChild(arg) then -- legacy /execute <player>
			Function.CharacterExecute(workspace[arg].Character or workspace[arg], arg)
		else
			warnf("Unknown morph/player: "..tostring(arg))
		end
	elseif cmd == "/uv" then me.UVToggle = (arg=="on") or (arg~=nil and arg~="off" and me.UVToggle==false); applySelf()
	elseif cmd == "/scale" then
		local n = tonumber(arg)
		if n then me.MuffinsScale = n; me.DonutsScale = n*50; applySelf() end
	elseif cmd == "/color" then
		if arg and arg:match("%d+,%s*%d+,%s*%d+") then
			local r,g,b = arg:match("(%d+),%s*(%d+),%s*(%d+)")
			OverrideColorAll(LocalPlayer.Name, Color3.fromRGB(tonumber(r),tonumber(g),tonumber(b)))
		elseif arg then
			for i,p in ipairs(CONFIG.ColorPresets) do
				if p.name:lower()==arg:lower() then me.ColorPresetIndex=i; OverrideColorAll(LocalPlayer.Name, p.c); break end
			end
		end
	elseif cmd == "/quality" then
		local map={auto=1,low=2,medium=3,high=4}
		if map[arg] then me.QualityIndex=map[arg]; print("[Morph] Quality → "..arg) end
	elseif cmd == "/physics" then me.PhysicsOn = not (arg=="off"); print("[Morph] Physics "..(me.PhysicsOn and "ON" or "OFF"))
	elseif cmd == "/bob" then me.BobOn = not (arg=="off")
	elseif cmd == "/help" then
		print([[── Morph Engine commands ──
/morph <Name|list>  /uv <on|off>  /scale <n>
/color <Preset|r,g,b>  /quality <auto|low|medium|high>
/physics <on|off>  /bob <on|off>]])
	end
end

local function BindChat()
	pcall(function()
		TextChatService.MessageReceived:Connect(function(msg)
			local src = msg.TextSource
			if src then task.spawn(DispatchCommand, src.Name, msg.Text) end
		end)
	end)
	pcall(function() -- legacy fallback (older chat systems)
		Players.PlayerAdded:Connect(function(plr)
			plr.Chatted:Connect(function(msg) task.spawn(DispatchCommand, plr.Name, msg) end)
		end)
		for _,plr in ipairs(Players:GetPlayers()) do
			plr.Chatted:Connect(function(msg) task.spawn(DispatchCommand, plr.Name, msg) end)
		end
	end)
end
