--#region ██ MAIN LOOP — RENDER PASS ██
local RNG = Random.new()
local function EaseOutBack(t) local c=1.70158; t=t-1; return t*t*((c+1)*t+c)+1 end

RunService.RenderStepped:Connect(function(dt)
	dt = math.min(dt, CONFIG.MaxFrameDelta)
	local qLevel = QualityLevel()
	local now = Clock()

	for dataName, pd in pairs(PlayerData) do
		local char = workspace:FindFirstChild(dataName)
		if char and char.PrimaryPart then
			local root = pd.LastRoot or char:FindFirstChild("HumanoidRootPart")
			if root then pd.LastRoot = root end

			-- squash & stretch spring (1-D packed in X)
			local sq = pd.SquashSpring
			sq.Target = Vector3.zero
			sq.Speed, sq.Damper = CONFIG.Squash.Speed, CONFIG.Squash.Damper
			sq:Step(dt)
			local s = math.clamp(sq.Position.X, -1.4, 1.4) * CONFIG.Squash.Gain
			local squash = Vector3.new(1 - s*0.5, 1 + s, 1 - s*0.5)

			-- glitch distortion envelope
			local glitchActive = now < pd.GlitchUntil
			local gMag = glitchActive and pd.GlitchMag or 0
			local glitchCF = glitchActive and CFrame.Angles(
				math.rad(RNG:NextNumber(-gMag,gMag)*40),
				math.rad(RNG:NextNumber(-gMag,gMag)*40), 0) or CFrame.identity

			-- ready-up progress
			local readyAlpha = 1
			if pd.ReadyT0 > 0 then
				readyAlpha = math.clamp((now - pd.ReadyT0)/0.45, 0, 1)
				if readyAlpha >= 1 then pd.ReadyT0 = 0 end
			end

			for inst, entry in pairs(pd.CurrentPartList.RealtimeUpdateList.Mesh) do
				if not inst.Parent then
					pd.CurrentPartList.RealtimeUpdateList.Mesh[inst] = nil
					pd.CurrentPartList.BodyPartPhysics[inst] = nil
					continue
				end
				local base = entry.Base
				if base and base.Parent then
					-- refresh multipliers only when the base resized
					if base.Size ~= entry.BaseSize then
						entry.BaseSize = base.Size
						local XM,YM,ZM = Function.MultiplyCalculate(base.Size, BodyPartSize[base.Name])
						entry.Mult = {X=XM,Y=YM,Z=ZM}
						entry.RawC0, entry.RawC1 = entry.C0, entry.C1
						entry.RawSize = entry.RawSize -- unchanged
					end
					local m = entry.Mult
					if not m then
						local XM,YM,ZM = Function.MultiplyCalculate(base.Size, BodyPartSize[base.Name])
						entry.Mult = {X=XM,Y=YM,Z=ZM}; m = entry.Mult
						entry.RawC0, entry.RawC1 = entry.C0, entry.C1
					end
					local weld = entry.Weld
					if weld and weld.Part1 then
						-- size = raw × limb-mult × physics-squish × global-squash
						local size = entry.RawSize
						local sf = entry.SizeFactor
						weld.Part1.Size = Vector3.new(size.x*m.X*sf.X*squash.X, size.y*m.Y*sf.Y*squash.Y, size.z*m.Z*sf.Z*squash.Z)
						local mesh = weld.Part1:FindFirstChildOfClass("SpecialMesh")
						if mesh and mesh.MeshType == Enum.MeshType.FileMesh then
							mesh.Scale = Vector3.new(size.x*m.X*sf.X*squash.X, size.y*m.Y*sf.Y*squash.Y, size.z*m.Z*sf.Z*squash.Z)
						end

						-- idle bob
						local bobCF = CFrame.identity
						if pd.BobOn and qLevel >= 2 then
							local amp = entry.BobAmpOverride or CONFIG.IdleBobDefault.Amp
							local ph = (pd.CurrentPartList.BodyPartPhysics[inst] and pd.CurrentPartList.BodyPartPhysics[inst].Phase) or 0
							bobCF = CFrame.new(
								math.sin(now*CONFIG.IdleBobDefault.Speed + ph)*amp*0.4,
								math.sin(now*CONFIG.IdleBobDefault.Speed*1.3 + ph)*amp, 0)
						end

						-- ready-up settle (back-eased overshoot + spin decay)
						local readyCF = CFrame.identity
						if entry.ReadyOff then
							if readyAlpha >= 1 then entry.ReadyOff = nil
							else
								local e = EaseOutBack(readyAlpha)
								local o = entry.ReadyOff
								readyCF = CFrame.new(o.Position * (1-e)) * CFrame.Angles(
									o:ToEulerAnglesXYZ() and select(1, o:ToEulerAnglesXYZ())*(1-e) or 0, 0, 0)
							end
						end

						weld.C0 = entry.C0 * (entry.PhysOffset or CFrame.identity) * bobCF * readyCF * glitchCF
						weld.C1 = entry.C1

						-- damage flicker
						if glitchActive then
							weld.Part1.Transparency = math.clamp(weld.Part1.Transparency,0,1) > 0
								and RNG:NextNumber(0, gMag) or weld.Part1.Transparency
						end
					end
				end
			end

			-- face animation (cheap, smoothed)
			if pd.FaceBits and pd.FaceBits.Mouth.Parent then
				local mt = pd.FaceTarget.Mouth or 0.5
				local cur = pd.FaceBits.Mouth.Size.Y
				local nxt = cur + (mt - cur)*math.min(dt*10,1)
				pd.FaceBits.Mouth.Size = Vector3.new(0.42, nxt, 0.08)
			end
		end
	end

	if Gui.Open and Gui.Dirty then SyncGui() end
end)
--#endregion

--#region ██ MAIN LOOP — PHYSICS PASS (batched, culled, quality-aware) ██
local StepParity = 0
RunService.Stepped:Connect(function(_, dt)
	dt = math.min(dt, CONFIG.MaxFrameDelta)
	StepParity += 1
	local qLevel = QualityLevel()

	for dataName, pd in pairs(PlayerData) do
		local char = workspace:FindFirstChild(dataName)
		if char and pd.PhysicsOn and pd.BodyPhysics then
			local base0 = pd.LastRoot or char:FindFirstChild("HumanoidRootPart")

			-- ── camera-aware culling (once per character, not per part)
			local culled = true
			if base0 then
				local camPos = Camera.CFrame.Position
				local dist = (camPos - base0.Position).Magnitude
				if dist < CONFIG.MaxViewDistance then
					local _, onScreen = pcall(function() return Camera:WorldToScreenPoint(base0.Position) end)
					culled = not (onScreen and onScreen.Z > 0)
				end
				if dist > CONFIG.MaxViewDistance * 1.6 then
					for inst in pairs(pd.CurrentPartList.BodyPartPhysics) do
						pd.CurrentPartList.BodyPartPhysics[inst].SkipTime = 0
					end
				end
			end

			local phys = pd.CurrentPartList.BodyPartPhysics
			-- resolve chain links lazily
			for inst, entry in pairs(phys) do
				if entry.Chain and not entry.ChainEntry then
					for other, oe in pairs(phys) do
						if other.Name == entry.Chain then entry.ChainEntry = oe; break end
					end
				end
			end

			-- two passes: roots first, then chained (built-in response delay)
			for pass = 1, 2 do
				for inst, entry in pairs(phys) do
					local isChained = entry.ChainEntry ~= nil
					if (pass == 1 and not isChained) or (pass == 2 and isChained) then
						if not inst.Parent or Function.FallenPartCheck(inst) then
							phys[inst] = nil
						elseif not culled and (qLevel >= 2 or StepParity % 2 == 0) then
							local e = entry
							local spr = e.Spring
							e.EntryQ = qLevel

							-- fast-forward after a cull pause
							if e.SkipTime > 0 then
								spr:TimeSkip(math.min(e.SkipTime, 0.5))
								e.SkipTime = 0
							end

							e.PrevVel = spr.Velocity
							local baseCF = e.Base.CFrame
							local origin = e.OriginCFrame

							-- drive impulse: positional lag + look-vector shear (original recipe)
							local posDist = origin.Position - baseCF.Position
							local lookDist = origin.LookVector - baseCF.LookVector
							spr:Impulse(posDist + Vector3.new(lookDist.X, lookDist.Y, 0))

							-- ambient forces: wind noise + chain whip
							if qLevel >= 2 then
								local wn = CONFIG.WindNoise * (qLevel == 3 and 1 or 0.5)
								spr:AddForce(Vector3.new(RNG:NextNumber(-wn,wn), RNG:NextNumber(-wn,wn), RNG:NextNumber(-wn,wn)))
							end
							local parent = e.ChainEntry
							if parent then
								local f = (parent.PrevVel - spr.Velocity) * (e.Profile.ChainK or 0.4) * 40
								if f.Magnitude > 140 then f = f.Unit * 140 end
								spr:AddForce(f)
							end

							spr:Step(dt)

							-- settle gate
							local nx, ny, nz = Function.CompareVector3(spr.Velocity, Vector3.new(0.0015,0.0015,0.0015))
							if nx and ny and nz then
								e.PhysOffset = CFrame.identity
								e.SizeFactor = Vector3.one
							else
								local posL, rotL = {X=0,Y=0,Z=0}, {X=0,Y=0,Z=0}
								for from,to in pairs(e.PosOff) do
									posL[from] = ((e.Profile.PosGain[to] or 0) * spr.Velocity[to]) * CONFIG.PhysicsMultiply.Position
								end
								for from,to in pairs(e.RotOff) do
									rotL[from] = math.rad(e.Profile.RotGain[to] * spr.Velocity[to]) * CONFIG.PhysicsMultiply.Rotation
								end
								e.PhysOffset = CFrame.new(posL.X, posL.Y, posL.Z)
									* CFrame.Angles(rotL.X, rotL.Y, -rotL.Z)
								if e.Profile.Squish then
									local sg = e.Profile.SquishGain or 1
									e.SizeFactor = Vector3.new(
										math.clamp(1 + rotL.X/4*sg, 0.8, 1.1),
										math.clamp(1 + rotL.Y/4*sg, 0.8, 1.1),
										math.clamp(1 + rotL.Z/4*sg, 0.8, 1.1))
								end
								-- trails (High quality only)
								if qLevel == 3 and spr.Velocity.Magnitude > CONFIG.TrailThreshold then
									local tr = GetEmitter(dataName, inst, "trail")
									if tr then tr.Enabled = true; tr.Rate = math.min(spr.Velocity.Magnitude*2, 90) end
								else
									local tr = GetEmitter(dataName, inst, "trail")
									if tr then tr.Enabled = false end
								end
							end

							e.OriginCFrame = baseCF
						elseif culled then
							entry.SkipTime += dt
						end
					end
				end
			end
		end
	end
end)
--#endregion

--#region ██ HEARTBEAT — FPS WATCH / EMOTION / FOOTSTEPS / HUD ██
local fpsFrames, fpsWindow = 0, 0
local emotionClock = 0
RunService.Heartbeat:Connect(function(dt)
	fpsFrames += 1; fpsWindow += dt
	if fpsWindow >= 0.5 then
		FPSAvg = fpsFrames / fpsWindow
		fpsFrames, fpsWindow = 0, 0
		-- adaptive quality with hysteresis (auto mode)
		if PlayerData[LocalPlayer.Name] and PlayerData[LocalPlayer.Name].QualityIndex == 1 then
			if FPSAvg < CONFIG.QualityAutoFPS.Low and QualityTier ~= "Low" then QualityTier = "Low"
			elseif FPSAvg < CONFIG.QualityAutoFPS.Medium and QualityTier == "High" then QualityTier = "Medium"
			elseif FPSAvg > CONFIG.QualityAutoFPS.Medium + 12 and QualityTier ~= "High" then QualityTier = "High" end
			Gui.HudDirty = true
		end
	end

	emotionClock += dt
	if emotionClock >= 0.1 then
		emotionClock = 0
		for dataName, pd in pairs(PlayerData) do
			local char = workspace:FindFirstChild(dataName)
			if char and (pd.CurrentPartList.FaceKit or char:FindFirstChild("Morph")) then
				UpdateEmotion(pd, char)
			end
			-- footsteps (self only, keeps cost trivial)
			if dataName == LocalPlayer.Name and char and pd.LastRoot then
				local hum = char:FindFirstChildOfClass("Humanoid")
				local root = pd.LastRoot
				if hum and root and hum.FloorMaterial ~= Enum.Material.Air then
					local hv = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z)
					if hv.Magnitude > 4 then
						pd.FootAccum += hv.Magnitude * dt
						if pd.FootAccum >= CONFIG.FootstepStride then
							pd.FootAccum = 0
							pd.FootSide = -pd.FootSide
							PlaySound("Step", root, 0.85 + math.random()*0.35)
							if QualityLevel() >= 2 then
								local att = GetEmitter(dataName, root, "puff")
								if att then att:Emit(3) end
							end
						end
					end
				end
			end
		end
	end

	if Gui.Hud and Gui.HudDirty then Gui.HudDirty = false; SyncHud() end
end)
--#endregion

--#region ██ INPUT BINDINGS ██
local ClickApplyActive = false
local ClickHighlight = nil

UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	local pd = Function.PlayerDataAdd(LocalPlayer.Name)
	local kc = input.KeyCode
	local function applySelf()
		if LocalPlayer.Character then Function.CharacterExecute(LocalPlayer.Character, LocalPlayer.Name) end
	end

	if kc == Enum.KeyCode.C then
		pd.UVToggle = not pd.UVToggle; applySelf(); warnf("Toggled UV → "..tostring(pd.UVToggle))
	elseif kc == Enum.KeyCode.RightBracket then
		pd.MuffinsScale += 0.2; pd.DonutsScale += 5; applySelf()
		warnf("Scale → muffins "..pd.MuffinsScale.." / donuts "..pd.DonutsScale)
	elseif kc == Enum.KeyCode.LeftBracket then
		pd.MuffinsScale = math.max(0.2, pd.MuffinsScale - 0.2)
		pd.DonutsScale = math.max(5, pd.DonutsScale - 5); applySelf()
		warnf("Scale → muffins "..pd.MuffinsScale.." / donuts "..pd.DonutsScale)
	elseif kc == Enum.KeyCode.B then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr.Character then task.spawn(Function.CharacterExecute, plr.Character, plr.Name) end
		end
	elseif kc == Enum.KeyCode.P then
		local order = CONFIG.MorphCycleOrder
		local idx = table.find(order, pd.SelectedMorphName) or 0
		pd.SelectedMorphName = order[(idx % #order) + 1]
		applySelf(); Gui.Dirty = true
		print("[Morph] → "..pd.SelectedMorphName)
	elseif kc == Enum.KeyCode.Equals then
		-- click-to-apply (improved: reusable highlight, = again cancels)
		if ClickApplyActive then
			ClickApplyActive = false
			if ClickHighlight then ClickHighlight:Destroy(); ClickHighlight = nil end
			return
		end
		ClickApplyActive = true
		ClickHighlight = Instance.new("Highlight")
		ClickHighlight.FillColor = Color3.fromRGB(120,255,180)
		local mouse = LocalPlayer:GetMouse()
		local mvConn
		mvConn = RunService.RenderStepped:Connect(function()
			if not ClickApplyActive then mvConn:Disconnect(); return end
			local tgt = mouse.Target
			local model = tgt and tgt:FindFirstAncestorOfClass("Model")
			if model and model:FindFirstChildOfClass("Humanoid") then
				ClickHighlight.Parent = model
			elseif ClickHighlight.Parent then
				ClickHighlight.Parent = nil
			end
		end)
		local clickConn
		clickConn = mouse.Button1Down:Connect(function()
			if ClickHighlight and ClickHighlight.Parent then
				local m = ClickHighlight.Parent
				Function.CharacterExecute(m, m.Name)
			end
			ClickApplyActive = false
			mvConn:Disconnect(); clickConn:Disconnect()
			if ClickHighlight then ClickHighlight:Destroy(); ClickHighlight = nil end
		end)
	elseif kc == Enum.KeyCode.G then
		if DrawingSupported() then
			BuildGui()
			Gui.Open = not Gui.Open; Gui.Dirty = true; SyncGui()
		else
			warnf("Drawing API unavailable — use /morph <Name> instead")
		end
	elseif kc == Enum.KeyCode.V then
		pd.ColorPresetIndex = (pd.ColorPresetIndex % #CONFIG.ColorPresets) + 1
		local preset = CONFIG.ColorPresets[pd.ColorPresetIndex]
		OverrideColorAll(LocalPlayer.Name, preset.c)
		warnf("Color → "..preset.name)
	elseif kc == Enum.KeyCode.X then
		pd.QualityIndex = (pd.QualityIndex % 4) + 1
		local names = {[1]="Auto",[2]="Low",[3]="Medium",[4]="High"}
		warnf("Quality → "..names[pd.QualityIndex]); Gui.HudDirty = true
	elseif kc == Enum.KeyCode.N then
		if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Morph") then
			Function.CharacterReset(LocalPlayer.Character, LocalPlayer.Name)
			warnf("Morph removed (N to re-apply via /morph)")
		else applySelf() end
	elseif kc == Enum.KeyCode.M then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr.Character then
				task.spawn(function()
					if plr.Character:FindFirstChild("Morph") then
						Function.CharacterReset(plr.Character, plr.Name)
					else Function.CharacterExecute(plr.Character, plr.Name) end
				end)
			end
		end
	elseif kc == Enum.KeyCode.H then
		pd.HudOn = not pd.HudOn; Gui.HudDirty = true
	elseif input.UserInputType == Enum.UserInputType.MouseButton1 and Gui.Open and Gui.HoverIdx > 0 then
		pd.SelectedMorphName = Gui.Items.list[Gui.HoverIdx].name
		applySelf(); Gui.Dirty = true
	end
end)

