--#region ██ SPRING MODULE (damped harmonic oscillator, per-axis tunable) ██
-- Semi-implicit Euler integration:  a = -ω²·(x-target) - c·v + Fext
-- c = Damper·2ω  →  Damper≈1 is critically damped, <1 bounces, >1 sludges.
-- AirDrag bleeds velocity exponentially (natural inertia/lag). ExtForce lets
-- the engine inject wind noise, gravity sag and chain coupling cleanly.
local Spring = {}
Spring.__index = Spring

function Spring.new(position)
	return setmetatable({
		Position     = position or Vector3.zero,
		Velocity     = Vector3.zero,
		Target       = position or Vector3.zero,
		Speed        = 10,       -- ω (rad/s): higher = snappier
		Damper       = 0.25,     -- ζ-ish: lower = jigglier
		AirDrag      = 0.6,      -- 1/s velocity bleed (air resistance)
		MaxDisplace  = 8,        -- safety clamp
		ExtForce     = Vector3.zero,
		AxisTune     = nil,      -- optional {[\"X\"]={Speed=,Damper=,Drag=}, ...}
	end, Spring)
end

function Spring:SetTarget(t) self.Target = t end
function Spring:Impulse(f)   self.Velocity += f end
function Spring:AddForce(f)  self.ExtForce  += f end
function Spring:ConfigureAxis(t) self.AxisTune = t end

function Spring:Step(dt)
	local tune = self.AxisTune
	local p, v, tg = self.Position, self.Velocity, self.Target
	for _, ax in ipairs({"X","Y","Z"}) do
		local w, dmp, drag = self.Speed, self.Damper, self.AirDrag
		if tune then
			local t2 = tune[ax]
			if t2 then
				w   = t2.Speed  or w
				dmp = t2.Damper or dmp
				drag= t2.Drag   or drag
			end
		end
		local x  = p[ax] - tg[ax]
		local a  = -(w*w)*x - (dmp*2*w)*v[ax] + self.ExtForce[ax]
		local nv = (v[ax] + a*dt) * math.exp(-drag*dt)
		v = Vector3.new(
			ax=="X" and nv or v.X,
			ax=="Y" and nv or v.Y,
			ax=="Z" and nv or v.Z)
	end
	self.ExtForce = Vector3.zero
	p += v*dt
	if p.Magnitude > self.MaxDisplace then p = p.Unit * self.MaxDisplace end
	-- settle kill (stops micro-jitter / saves CPU)
	if v.Magnitude < 1e-3 and (p-tg).Magnitude < 1e-4 then v = Vector3.zero; p = tg end
	self.Position, self.Velocity = p, v
end

-- Fast-forward simulation after a pause/cull; stable fixed substepping.
function Spring:TimeSkip(duration)
	local steps = math.clamp(math.ceil(duration / CONFIG.SpringSubstep), 1, 240)
	local h = duration / steps
	for _ = 1, steps do self:Step(h) end
end
