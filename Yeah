--#region ██ FACE EXPRESSIONS / FOOTSTEPS / GLITCH ██
local EMOTION_COLORS = {Happy=Color3.new(1,1,1), Scared=Color3.fromRGB(160,200,255),
	Angry=Color3.fromRGB(255,120,100), Dizzy=Color3.fromRGB(255,230,120)}

function BuildFaceKit(char, pd, morphDef)
	pcall(function()
		if morphDef == PART_LISTS.Robot then return end -- visor IS the face
		local head = char:FindFirstChild("Head")
		if not head or head.Transparency == 1 then
			head = char.Morph and char.Morph:FindFirstChild("SnowHead")
		end
		if not head then return end
		local kit = Instance.new("Folder"); kit.Name = "FaceKit"; kit.Parent = head
		pd.CurrentPartList.FaceKit = kit
		local function bit(name,size,pos,color)
			local p=Instance.new("Part"); p.Name=name; p.Size=size
			p.Shape=Enum.PartType.Ball; p.Color=color; p.Material=Enum.Material.Neon
			p.CanCollide,p.CanQuery,p.CanTouch,p.Massless=false,false,false,true
			local w=Instance.new("Weld"); w.Part0=head; w.Part1=p; w.C0=CFrame.new(pos); w.Parent=p; p.Parent=kit
			return p
		end
		bit("EyeL", Vector3.new(0.18,0.24,0.1), Vector3.new(-0.28,0.25,-0.62), Color3.new(1,1,1))
		bit("EyeR", Vector3.new(0.18,0.24,0.1), Vector3.new( 0.28,0.25,-0.62), Color3.new(1,1,1))
		bit("BrowL", Vector3.new(0.26,0.05,0.08), Vector3.new(-0.28,0.47,-0.58), Color3.fromRGB(40,40,45))
		bit("BrowR", Vector3.new(0.26,0.05,0.08), Vector3.new( 0.28,0.47,-0.58), Color3.fromRGB(40,40,45))
		local mouth = bit("Mouth", Vector3.new(0.42,0.12,0.08), Vector3.new(0,-0.12,-0.62), Color3.fromRGB(50,30,35))
		pd.FaceBits = {Mouth=mouth, BrowL=kit.BrowL, BrowR=kit.BrowR}
	end)
end

local function UpdateEmotion(pd, char)
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not hum or not root then return end
	local v = root.AssemblyLinearVelocity
	local t = "Happy"
	if Clock() < (pd.HurtUntil or 0) then t = "Angry"
	elseif hum:GetState() == Enum.HumanoidStateType.Freefall and v.Y < -55 then t = "Scared"
	elseif Vector3.new(v.X,0,v.Z).Magnitude > 55 then t = "Dizzy" end
	if t ~= pd.FaceTarget.Emotion then
		pd.FaceTarget.Emotion = t
		pcall(function()
			local bits = pd.FaceBits
			if bits then
				local scared = t=="Scared"; local angry=t=="Angry"
				bits.EyeL = bits.EyeL or (pd.CurrentPartList.FaceKit and pd.CurrentPartList.FaceKit.EyeL)
				local kit = pd.CurrentPartList.FaceKit
				if kit then
					kit.EyeL.Size = scared and Vector3.new(0.24,0.3,0.1) or Vector3.new(0.18,angry and 0.16 or 0.24,0.1)
					kit.EyeR.Size = scared and Vector3.new(0.24,0.3,0.1) or Vector3.new(0.18,angry and 0.16 or 0.24,0.1)
				end
				bits.BrowL.Rotation = angry and CFrame.Angles(0,0,math.rad(22)) or CFrame.Angles(0,0,scared and math.rad(-14) or 0)
				bits.BrowR.Rotation = angry and CFrame.Angles(0,0,math.rad(-22)) or CFrame.Angles(0,0,scared and math.rad(14) or 0)
			end
			local visor = char.Morph and char.Morph:FindFirstChild("EyeVisor")
			if visor then visor.Color = EMOTION_COLORS[t] end
		end)
	end
	local speed = v.Magnitude
	pd.FaceTarget.Mouth = 0.35 + math.clamp(speed/70,0,1)*1.1
		+ (hum:GetState()==Enum.HumanoidStateType.Freefall and 0.5 or 0)
end

local function TriggerGlitch(pd, dmg)
	pd.GlitchUntil = Clock() + math.min(CONFIG.GlitchDuration, 0.15 + dmg*0.02)
	pd.GlitchMag = math.clamp(dmg*0.02, 0.08, 0.5)
	PlaySound("Glitch", pd.LastRoot, 0.55, 0.3)
end

local function BindCharacterEvents(char, dataName)
	local pd = Function.PlayerDataAdd(dataName)
	for _, c in ipairs(pd.Conns) do pcall(function() c:Disconnect() end) end
	pd.Conns = {}
	pd.LastRoot = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		local lastHealth = hum.Health
		table.insert(pd.Conns, hum.HealthChanged:Connect(function(h)
			if h < lastHealth - 0.5 then TriggerGlitch(pd, lastHealth - h)
			elseif h > lastHealth then pd.HurtUntil = 0 end
			lastHealth = h
		end))
		table.insert(pd.Conns, hum.StateChanged:Connect(function(_, new)
			local sq = pd.SquashSpring
			local root = pd.LastRoot
			if new == Enum.HumanoidStateType.Jumping then
				sq:Impulse(Vector3.new(CONFIG.Squash.JumpKick,0,0)) -- negative = stretch
				PlaySound("Jump", root, 0.9+math.random()*0.2)
			elseif new == Enum.HumanoidStateType.Landed then
				local fall = root and math.abs(root.AssemblyLinearVelocity.Y) or 20
				sq:Impulse(Vector3.new(CONFIG.Squash.LandKick*math.clamp(fall/50,0.3,1.6),0,0))
				PlaySound("Land", root, 0.8+math.random()*0.4)
				local puff = root and GetEmitter(dataName, root, "puff")
				if puff then puff:Emit(math.random(6,12)) end
			end
		end))
		table.insert(pd.Conns, hum.Died:Connect(function()
			task.delay(1.5, function() Function.CharacterReset(char, dataName) end)
		end))
	end
end
