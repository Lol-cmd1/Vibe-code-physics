function Function.ApplyUV(obj, char, extra)
	local n = obj.Name:lower()
	if not (n:find("uv") or n:find("texture")) then return end
	if n:find("shirt") or n:find("muffin") or n:find("chest") or n:find("torso") or n:find("arm") then
		obj.TextureID = extra.Shirt and extra.Shirt.ShirtTemplate or obj.TextureID
	end
	if n:find("pant") or n:find("donut") or n:find("butt") or n:find("leg") then
		obj.TextureID = extra.Pants and extra.Pants.PantsTemplate or obj.TextureID
	end
	obj.Transparency = 0.02
end
