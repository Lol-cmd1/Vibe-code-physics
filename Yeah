function Function.PlayerDataAdd(name)
	if not PlayerData[name] then PlayerData[name] = Function.PlayerDataDefault() end
	return PlayerData[name]
end

function Function.MultiplyCalculate(Base, Default)
	return Base.X/Default.X, Base.Y/Default.Y, Base.Z/Default.Z
end
function Function.TabletoVector(t) return Vector3.new(t.x, t.y, t.z) end
function Function.StringtoColor3(str)
	local r,g,b = str:match("([^,]+),([^,]+),([^,]+)")
	return Color3.fromRGB(math.round(tonumber(r) or 0), math.round(tonumber(g) or 0), math.round(tonumber(b) or 0))
end
function Function.TabletoString(v, spaces, semi, depth)
	spaces = spaces or 4
	if type(v) ~= "table" then return type(v)=="string" and ('"%s"'):format(v) or tostring(v) end
	if not next(v) then return "{}" end
	depth = depth or 1
	local pad = (" "):rep(depth*spaces)
	local sep = semi and ";" or ","
	local out = {"{"}
	for k,x in next,v do
		out[#out+1] = ("\n%s[%s] = %s%s"):format(pad, type(k)=="number" and k or ('"%s"'):format(tostring(k)),
			Function.TabletoString(x, spaces, semi, depth+1), sep)
	end
	local s = table.concat(out)
	return ("%s\n%s}"):format(s:sub(1,-2), pad:sub(1,-spaces-1))
end
function Function.StringtoTable(str)
	local tbl = {}
	for k,v in str:gmatch('%[\"(.-)\"%] = \"(.-)\"') do tbl[k] = v end
	return tbl
end
function Function.Table2CF(t)
	if type(t) ~= "table" then return t end
	local r,p = t.Rotation, t.Position
	return CFrame.new(p.x,p.y,p.z) * CFrame.fromEulerAnglesYXZ(math.rad(r.x),math.rad(r.y),math.rad(r.z))
end
function Function.DarkenColor(c,a) return c:Lerp(Color3.new(0,0,0), a) end
function Function.CFrameMultiply(cf,m)
	return CFrame.new(cf.Position.X*m.X, cf.Position.Y*m.Y, cf.Position.Z*m.Z) * cf.Rotation
end
function Function.Vector3Multiply(v,m) return Vector3.new(v.X*m.X, v.Y*m.Y, v.Z*m.Z) end
function Function.CompareVector3(a,b)
	return math.abs(a.X)<=b.X, math.abs(a.Y)<=b.Y, math.abs(a.Z)<=b.Z
end
function Function.FallenPartCheck(obj)
	return obj:IsA("BasePart") and obj.Parent and obj.Position.Y < workspace.FallenPartsDestroyHeight
end

