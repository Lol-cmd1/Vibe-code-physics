local TEX_SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local TEX_SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local function GetEmitter(dataName, part, kind)
	local pd = PlayerData[dataName]; if not pd then return nil end
	local cache = pd.CurrentPartList.EmitterCache
	if cache[part] then return cache[part] end
	local pe = Instance.new("ParticleEmitter")
	if kind == "trail" then
		pe.Texture = TEX_SPARK; pe.Rate = 40; pe.Lifetime = NumberRange.new(0.25,0.5)
		pe.Speed = NumberRange.new(1,2); pe.Size = NumberSequence.new(0.35,0)
		pe.LightEmission = 0.8; pe.Color = ColorSequence.new(Color3.fromRGB(180,220,255))
	else -- puff
		pe.Texture = TEX_SMOKE; pe.Rate = 0; pe.Lifetime = NumberRange.new(0.3,0.6)
		pe.Speed = NumberRange.new(2,4); pe.SpreadAngle = Vector2.new(35,35)
		pe.Size = NumberSequence.new{NumberSequenceKeypoint.new(0,0.4),NumberSequenceKeypoint.new(1,0.9)}
		pe.Transparency = NumberSequence.new{NumberSequenceKeypoint.new(0,0.4),NumberSequenceKeypoint.new(1,1)}
	end
	pe.Enabled = false; pe.Parent = part
	cache[part] = pe
	return pe
end
