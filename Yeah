function Function.createSurfaceAppearance(obj, char, extra, dataName, payload)
	payload = type(payload)=="table" and payload[1] or payload
	pcall(function()
		if IsStudio then return warnf("Studio detected — SurfaceAppearance skipped") end
		if not payload or not payload.ColorMap then return end
		local sa = Instance.new("SurfaceAppearance")
		sa.ColorMap = payload.ColorMap
