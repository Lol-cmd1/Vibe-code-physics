--#region ██ LIFECYCLE / EVENT-DRIVEN AUTOAPPLY / UNLOAD ██
local MasterConns = {}

if CONFIG.AutoApply then
	table.insert(MasterConns, Players.PlayerAdded:Connect(function(plr)
		plr.CharacterAdded:Connect(function(ch)
			ch:WaitForChild("Humanoid", 10)
			task.wait(0.35)
			local pd = Function.PlayerDataAdd(plr.Name)
			Function.CharacterExecute(ch, plr.Name)
		end)
	end))
	for _, plr in ipairs(Players:GetPlayers()) do
		plr.CharacterAdded:Connect(function(ch)
			ch:WaitForChild("Humanoid", 10)
			task.wait(0.35)
			Function.PlayerDataAdd(plr.Name)
			Function.CharacterExecute(ch, plr.Name)
		end)
	end
end

table.insert(MasterConns, Players.PlayerRemoving:Connect(function(plr)
	PlayerData[plr.Name] = nil
end))

local function Unload()
	warnf("Unloading…")
	for _, c in ipairs(MasterConns) do pcall(function() c:Disconnect() end) end
	for _, plr in ipairs(Players:GetPlayers()) do
		local pd = PlayerData[plr.Name]
		if pd then
			for _, c in ipairs(pd.Conns) do pcall(function() c:Disconnect() end) end
			local ch = workspace:FindFirstChild(plr.Name)
			if ch then Function.CharacterReset(ch, plr.Name) end
		end
	end
	if Gui.Items then
		pcall(function() Gui.Items.bg:Remove() end)
		pcall(function() Gui.Items.title:Remove() end)
		pcall(function() Gui.Items.hint:Remove() end)
		for _, b in ipairs(Gui.Items.list) do b.bg:Remove(); b.tx:Remove() end
	end
	if Gui.Hud then Gui.Hud.bg:Remove(); Gui.Hud.tx:Remove() end
	PlayerData = {}
	_g.__MorphEngineUnload = nil
	print("[Morph] Unloaded cleanly.")
end
_g.__MorphEngineUnload = Unload
