--#region ██ WELDING SYSTEM ██
local PART_LISTS = nil -- filled at bootstrap (needs globals aliased first)

function Function.Weld(cfg, char, extra, dataName)
	local pd = Function.PlayerDataAdd(dataName)
	local ok, result = pcall(function()
		local NAME      = cfg.Name
		local PARENT    = cfg.Parent or {"Torso"}
		if not PARENT[1] then PARENT[1] = "Torso" end

		local CFRAME    = cfg.Joint and cfg.Joint.CFrame  or {Rotation={x=0,y=0,z=0},Position={x=0,y=0,z=0}}
		local CFRAME1   = cfg.Joint and cfg.Joint.CFrame1 or {Rotation={x=0,y=0,z=0},Position={x=0,y=0,z=0}}
		local SIZE      = cfg.Size or {x=1,y=1,z=1}
		local ADJUST    = cfg.AdjustScale
		local SCALEKEY  = cfg.ScaleKey

		-- locate root body part + size multipliers
		local BodyPart = char.Morph:FindFirstChild(PARENT[1])
		if BodyPart == nil or BodyPartSize[BodyPart.Name] == nil then BodyPart = char.Torso end
		local XM, YM, ZM = Function.MultiplyCalculate(BodyPart.Size, BodyPartSize[BodyPart.Name])

		-- resolve deep parent chain inside Morph
		local parent = char.Morph
		for i = 1, #PARENT do
			parent = parent and parent:FindFirstChild(PARENT[i])
			if not parent then break end
		end
		if parent == nil then
			local root = PARENT[#PARENT]
			pd.deferredWelds[root] = pd.deferredWelds[root] or {}
			table.insert(pd.deferredWelds[root], cfg)
			return dprint("Deferred:", NAME, "(missing "..root..")")
		end

		-- accessory scale keys ([ and ] hotkeys)
		local Scale = 1
		if SCALEKEY and pd[SCALEKEY] then
			local sVal = pd[SCALEKEY]
			Scale = (sVal >= 1) and (1 + (sVal-1)/5) or (1 + (sVal-1)/10)
			if sVal == 1 then Scale = 1 end
			if ADJUST == nil or table.find(ADJUST, "Size") then
				SIZE = Function.Vector3Multiply(Function.TabletoVector(SIZE), {X=Scale,Y=Scale,Z=Scale})
			end
			if ADJUST == nil or table.find(ADJUST, "CFrame1") then
				CFRAME1 = Function.CFrameMultiply(Function.Table2CF(CFRAME1), {X=Scale,Y=Scale,Z=Scale})
			end
			if ADJUST and table.find(ADJUST, "CFrame") then
				CFRAME = Function.CFrameMultiply(Function.Table2CF(CFRAME), {X=Scale,Y=Scale,Z=Scale})
			end
		end

		-- build the instance
		local obj
		if cfg.Instance == "Mesh" then
			local okM, meshOrErr = pcall(function()
				return InsertService:CreateMeshPartAsync(cfg.MeshId, Enum.CollisionFidelity.Box, Enum.RenderFidelity.Performance)
			end)
			if okM then
				obj = meshOrErr
				if cfg.TextureId then obj.TextureID = cfg.TextureID end
				obj.Color = Color3.new(1,1,1) -- let Color prop below win over texture bake
			else
				warnf(("Mesh %s failed (%s) — substituting block"):format(NAME, tostring(meshOrErr)))
				obj = Instance.new("Part")
			end
		else
			obj = Instance.new("Part")
			obj.Shape = cfg.Shape or Enum.PartType.Block
			local mc = cfg.Mesh
			if mc then
				local mesh = Instance.new("SpecialMesh")
				mesh.Name = NAME..".Mesh"
				local mScale = Function.TabletoVector(mc.Scale)
				mesh.MeshType = mc.MeshType or Enum.MeshType.Sphere
				mesh.MeshId = mc.MeshId or ""
				mesh.TextureId = mc.TextureId or ""
				mesh.Scale = (mesh.MeshType == Enum.MeshType.FileMesh)
					and Function.Vector3Multiply(mScale, {X=XM*Scale, Y=YM*Scale, Z=ZM*Scale})
					or mScale
				mesh.Parent = obj
			end
		end

		-- core props
		obj.Name = cfg.Name
		obj.CanCollide, obj.CanQuery, obj.CanTouch, obj.Massless = false, false, false, true
		obj.CastShadow = false
		obj.Transparency = cfg.Transparency or 0
		obj.Material = cfg.Material or Enum.Material.SmoothPlastic
		if cfg.ReflectanceHint then obj.Reflectance = 0.08 end

		-- extras → decals (respect authored Color3; fall back to darkened torso)
		if cfg.Extra then
			for exName, prop in pairs(cfg.Extra) do
				local d = Instance.new("Decal")
				d.Name = exName
				d.Transparency = prop.Transparency or 0
				d.ZIndex = prop.ZIndex or 1
				d.Face = prop.Face or Enum.NormalId.Front
				d.Texture = prop.Texture or ""
				d.Color3 = prop.Color3 and Function.StringtoColor3(prop.Color3)
					or Function.DarkenColor(char.Torso.Color, 0.32)
				d.Parent = obj
				pd.CurrentPartList.FrostingDecal[d] = obj
			end
		end

		-- weld
		local weld = Instance.new("Motor6D")
		weld.Name = NAME.." Weld"
		weld.C0 = Function.CFrameMultiply(Function.Table2CF(CFRAME), {X=XM,Y=YM,Z=ZM})
		weld.C1 = Function.CFrameMultiply(Function.Table2CF(CFRAME1), {X=XM,Y=YM,Z=ZM})
		obj.Size = Function.Vector3Multiply(Function.TabletoVector(SIZE), {X=XM,Y=YM,Z=ZM})
		obj.Parent = parent
		weld.Part0, weld.Part1 = parent, obj
		weld.Parent = obj

		if cfg.Physics and cfg.Physics.PhysicsRotationOffset then
			obj:SetAttribute("PhysicsRotationOffset", Function.TabletoString(cfg.Physics.PhysicsRotationOffset))
		end
		if cfg.Chain then obj:SetAttribute("Chain", cfg.Chain) end
		if cfg.IdleBob then obj:SetAttribute("IdleBob", tostring(cfg.IdleBob.Amp)) end

		-- color: explicit RGB > numeric-accent legacy > Base
		if typeof(cfg.RGB) == "Color3" then
			obj.Color = cfg.RGB
		elseif cfg.Color ~= nil and cfg.Color ~= "Base" then
			obj.Color = Function.DarkenColor(char.Torso.Color, pd.colorConfig.Values["110, 110, 111"])
		else
			obj.Color = char.Torso.Color
		end

		-- function dispatch: numbered = named handlers, keyed = handler+payload
		if cfg.Function then
			for k, v in pairs(cfg.Function) do
				pcall(function()
					if type(k) == "number" then
						if type(Function[v]) == "function" then Function[v](obj, char, extra, dataName) end
					elseif type(Function[k]) == "function" then
						Function[k](obj, char, extra, dataName, v)
					end
				end)
			end
		end

		-- UV-mode overrides
		if extra.UVToggle then
			local lower = NAME:lower()
			if lower:find("cherry") or lower:find("donut") then obj.Transparency = 1 end
			if lower:find("skin") then obj.Transparency = 0 end
			if cfg.UV == false then obj.Transparency = 1 end
			local stale = {}
			for d in pairs(pd.CurrentPartList.FrostingDecal) do
				if d:IsA("Decal") and d.Name == "Frosting Decal" then table.insert(stale, d) end
			end
			for _,d in ipairs(stale) do pd.CurrentPartList.FrostingDecal[d] = nil; d:Destroy() end
			local taco = char.Morph:FindFirstChild("TacoShell")
			if taco then taco:Destroy() end
			Function.ApplyUV(obj, char, extra)
		end

		pd.CurrentPartList.Organ[obj] = true
		pd.CurrentPartList.RealtimeUpdateList.Mesh[obj] = {
			Name = NAME, RawSize = Function.TabletoVector(SIZE),
			C0 = weld.C0, C1 = weld.C1, Base = BodyPart, Weld = weld,
			BaseSize = BodyPart.Size, HasPhysics = false,
			SizeFactor = Vector3.one, ReadyOff = nil,
		}

		-- unblock anything waiting on this name
		if pd.deferredWelds[NAME] then
			local queue = pd.deferredWelds[NAME]
			pd.deferredWelds[NAME] = nil
			for _, pendingCfg in ipairs(queue) do
				Function.Weld(pendingCfg, char, extra, dataName)
			end
		end
		return obj
	end)
	if not ok then warnf("Weld failed for "..tostring(cfg.Name)..": "..tostring(result)) end
	return result
end
--#endregion

