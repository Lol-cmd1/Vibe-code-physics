function OverrideColorAll(dataName, color)
	local pd = PlayerData[dataName]; if not pd then return end
	local char = workspace:FindFirstChild(dataName)
	local torso = char and char:FindFirstChild("Torso")
	local base = color or (torso and torso.Color)
	if not base then return end
	for inst in pairs(pd.CurrentPartList.Organ) do
		pcall(function()
			if inst:IsA("BasePart") and not inst.Name:match("UV") and inst.Transparency < 0.9
				and inst.Material ~= Enum.Material.Neon then
				inst.Color = base
			end
		end)
	end
	for decal in pairs(pd.CurrentPartList.FrostingDecal) do
		pcall(function() decal.Color3 = Function.DarkenColor(base, 0.32) end)
	end
end
