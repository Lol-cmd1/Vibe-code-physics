local function ResolveSpringFunction(fnName)
	return function(obj, char, extra, dataName)
		local prof = PHYSICS[fnName]; if not prof then return end
		local pd = Function.PlayerDataAdd(dataName)
		if not pd.BodyPartPhysics then return end
		local weld = obj:FindFirstChildOfClass("Motor6D")
		if not weld then return warnf("No Motor6D on "..obj.Name) end
		local base = weld.Part0
		local spr = Spring.new(Vector3.zero)
		spr.Speed, spr.Damper = prof.Speed, prof.Damper
		spr.AirDrag = prof.Drag or 0.6
		spr.MaxDisplace = prof.MaxDisplace or 8
		if prof.Axis then spr:ConfigureAxis(prof.Axis) end
		-- allow per-part PhysicsRotationOffset override (legacy attr)
		local rotOff = prof.RotOff
		local attr = obj:GetAttribute("PhysicsRotationOffset")
		if attr then
			local parsed = Function.StringtoTable(attr)
			rotOff = {X=parsed.X or "X", Y=parsed.Y or "Y", Z=parsed.Z or "Z"}
		end
		local bob = obj:GetAttribute("IdleBob")
		pd.CurrentPartList.BodyPartPhysics[obj] = {
			Spring = spr, Base = base, Weld = weld, Profile = prof,
			RotOff = rotOff, PosOff = prof.PosOff,
			OriginCFrame = base.CFrame, Phase = Clock()*7 + math.random()*6.28,
			PrevVel = Vector3.zero, SkipTime = 0, SizeFactor = Vector3.one,
			Chain = obj:GetAttribute("Chain"), ChainEntry = nil,
			BobAmp = bob and tonumber(bob) or nil,
		}
	end
end
for name in pairs(PHYSICS) do Function[name] = ResolveSpringFunction(name) end

