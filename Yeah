local function GuiHitTest()
	local it = Gui.Items
	if not it or not Gui.Open then Gui.HoverIdx=0; return end
	local m = UserInputService:GetMouseLocation()
	for i,btn in ipairs(it.list) do
		local p,s = btn.bg.Position, btn.bg.Size
		if m.X>=p.X and m.X<=p.X+s.X and m.Y>=p.Y and m.Y<=p.Y+s.Y then
			if Gui.HoverIdx ~= i then Gui.HoverIdx=i; Gui.Dirty=true end
