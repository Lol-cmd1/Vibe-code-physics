-- small builders to keep morph data readable (values identical to original)
local function V3(x,y,z) return {x=x,y=y,z=z} end
local function J(part0, r0, p0, r1, p1)
	r1, p1 = r1 or {0,-0,0}, p1 or {0,0,0}
	return {Part0=part0,
		CFrame ={Rotation=V3(r0[1],r0[2],r0[3]),Position=V3(p0[1],p0[2],p0[3])},
		CFrame1={Rotation=V3(r1[1],r1[2],r1[3]),Position=V3(p1[1],p1[2],p1[3])}}
end
local function IDJ(part0) return J(part0,{0,-0,0},{0,0,0}) end
local function MP(name, meshId, parent, joint, size, o)
	o = o or {}
	return {Instance="Mesh", MeshId=meshId, Name=name, Parent=parent, Joint=joint,
		Size=size, Transparency=o.T or 0, Material=o.M or Enum.Material.SmoothPlastic,
		Color=o.C or "Base", Function=o.F or {}, AdjustScale=o.AS, Physics=o.Ph,
		Extra=o.Ex, UV=o.UV, RGB=o.RGB, SizeMult=o.SM, Chain=o.Chain,
		ScaleKey=o.SK, IdleBob=o.IB}
end
local function PT(name, parent, joint, size, o)
	o = o or {}
	local t = {Instance="Part", Name=name, Parent=parent, Joint=joint, Size=size,
		Transparency=o.T or 0, Material=o.M or Enum.Material.SmoothPlastic,
		Shape=o.Shape or Enum.PartType.Block, Color=o.C or "Base",
		Function=o.F or {}, Extra=o.Ex, AdjustScale=o.AS, Physics=o.Ph,
		RGB=o.RGB, SizeMult=o.SM, Chain=o.Chain, ScaleKey=o.SK, IdleBob=o.IB, UV=o.UV}
	if o.Mesh then
		t.Mesh = {Scale=o.Mesh.Scale, MeshId=o.Mesh.Id or "",
			MeshType=o.Mesh.Type or Enum.MeshType.Sphere, TextureId=o.Mesh.Tex or ""}
	end
	return t
end
