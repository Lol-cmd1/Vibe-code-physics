	local SpringSet = {}
	SpringSet.__index = SpringSet

	function SpringSet.new(speed, damper)
		return setmetatable({
			P = { 0, 0, 0 },
			V = { 0, 0, 0 },
			T = { 0, 0, 0 },
			Speed  = { speed[1], speed[2], speed[3] },
			Damper = { damper[1], damper[2], damper[3] },
		}, SpringSet)
	end

	function SpringSet:Reset()
		for i = 1, 3 do
			self.P[i] = 0
			self.V[i] = 0
			self.T[i] = 0
		end
	end

	function SpringSet:TimeSkip(dt)
		for i = 1, 3 do
			local s = self.Speed[i]
			local d = self.Damper[i]
			local k = s * s
			local c = 2 * d * s
			local x = self.P[i] - self.T[i]
			local a = -k * x - c * self.V[i]
			self.V[i] = self.V[i] + a * dt
			self.P[i] = self.P[i] + self.V[i] * dt
		end
	end

	function SpringSet:Impulse(v)
		if v.X ~= 0 then self.V[1] = self.V[1] + v.X end
		if v.Y ~= 0 then self.V[2] = self.V[2] + v.Y end
		if v.Z ~= 0 then self.V[3] = self.V[3] + v.Z end
	end

	function SpringSet:ImpulseMapped(mapping, source)
		for From, To in pairs(mapping) do
			local ax = From == "X" and 1 or From == "Y" and 2 or 3
			local val = To == "X" and source.X or To == "Y" and source.Y or source.Z
			if val ~= 0 then self.V[ax] = self.V[ax] + val end
		end
	end

	function SpringSet:SetTargets(v)
		if v then
			self.T[1], self.T[2], self.T[3] = v.X, v.Y, v.Z
		else
			self.T[1], self.T[2], self.T[3] = 0, 0, 0
		end
	end

	function SpringSet:Get()
		return Vector3.new(self.P[1], self.P[2], self.P[3])
	end

	function SpringSet:GetVelocity()
		return Vector3.new(self.V[1], self.V[2], self.V[3])
	end

	local function MapVector(mapping, source)
		local out = Vector3.new()
		for From, To in pairs(mapping) do
			local ax = From == "X" and 1 or From == "Y" and 2 or 3
			local val = To == "X" and source.X or To == "Y" and source.Y or source.Z
			if ax == 1 then out = Vector3.new(val, out.Y, out.Z)
			elseif ax == 2 then out = Vector3.new(out.X, val, out.Z)
			else out = Vector3.new(out.X, out.Y, val) end
		end
		return out
	end

	local function ClampVector(v, max)
		return Vector3.new(
			math.clamp(v.X, -max, max),
			math.clamp(v.Y, -max, max),
			math.clamp(v.Z, -max, max)
		)
	end

	local function VaryCfg(base, variance)
		local cfg = {}
		for k, v in pairs(base) do cfg[k] = v end
		cfg.Speed = {
			cfg.Speed[1] * (1 + variance),
			cfg.Speed[2] * (1 + variance),
			cfg.Speed[3] * (1 - variance * 0.5),
		}
		return cfg
	end


