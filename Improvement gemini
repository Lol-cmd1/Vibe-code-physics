	-- ============================================================
	--  NEW PHYSICS LOOP: torso drive + paired interaction + squash
	-- ============================================================
	local PhysicsConnect = RunService.Stepped:Connect(function(_, rawDt)
		local dt = math.clamp(rawDt, 1 / 240, 1 / 30)
		local n = dt * 60 

		for PlayerName, DataList in pairs(PlayerData) do
			local Character = Players:FindFirstChild(PlayerName) and Players[PlayerName].Character
			if not Character then continue end

			local Base = Character:FindFirstChild("Torso") or Character.PrimaryPart
			if not Base then continue end

			local PList = DataList.CurrentPartList.BodyPartPhysics
			if not next(PList) then continue end

			local TState = DataList.TorsoState
			if not TState then
				TState = {}
				DataList.TorsoState = TState
			end

			local CF = Base.CFrame
			local LastCF = TState.LastCF or CF

			local vel = (CF.Position - LastCF.Position) / dt
			vel = TState.Vel and TState.Vel:Lerp(vel, 0.45) or vel

			local axis, ang = (LastCF.Rotation:Inverse() * CF.Rotation):ToAxisAngle()
			local angVel = axis * (ang / dt)
			angVel = TState.AngVel and TState.AngVel:Lerp(angVel, 0.45) or angVel

			local accel = (vel - (TState.LastVel or vel)) / dt
			accel = TState.Accel and TState.Accel:Lerp(accel, 0.5) or accel

			TState.LastCF = CF
			TState.LastVel = vel
			TState.Vel = vel
			TState.AngVel = angVel
			TState.Accel = accel

			local invRot = CF.Rotation:Inverse()
			local accelLocal = ClampVector(invRot * accel, 35)
			local angVelLocal = ClampVector(invRot * angVel, 6)

			if not TState.Paired then
				local groups = {}
				for _, Prop in pairs(PList) do
					if Prop.Type == "SpringRig" and (Prop.Group == "Breast" or Prop.Group == "Butt") and Prop.Side then
						groups[Prop.Group] = groups[Prop.Group] or {}
						groups[Prop.Group][Prop.Side] = Prop
					end
				end
				for _, sides in pairs(groups) do
					if sides.Left and sides.Right then
						sides.Left.Partner = sides.Right
						sides.Right.Partner = sides.Left
						local baseCF = sides.Left.Base.CFrame
						local aX = baseCF:PointToObjectSpace(sides.Left.Part.Position).X
						local bX = baseCF:PointToObjectSpace(sides.Right.Part.Position).X
						local rest = math.max(0.05, math.abs(aX - bX))
						sides.Left.RestSep = rest
						sides.Right.RestSep = rest
					end
				end
				TState.Paired = true
			end

			for Part, Prop in pairs(PList) do
				if Prop.Type ~= "SpringRig" then continue end
				if Function.FallenPartCheck(Part) then
					PList[Part] = nil
					continue
				end

				local Cfg = Prop.Config

				if (Part.Position - Base.Position).Magnitude > 15 then
					Prop.Pos:Reset()
					Prop.Rot:Reset()
					if Prop.Jig then Prop.Jig:Reset() end
				end

				Prop.Pos:TimeSkip(dt)
				Prop.Rot:TimeSkip(dt)
				if Prop.Jig then Prop.Jig:TimeSkip(dt) end

				Prop.Pos:ImpulseMapped(Prop.PosMap, accelLocal * (Cfg.Kick * n))
				Prop.Rot:ImpulseMapped(Prop.RotMap, angVelLocal * (Cfg.RotKick * n))

				if Prop.Jig then
					Prop.Jig:ImpulseMapped(Prop.PosMap, accelLocal * (Cfg.Jiggle * n * 2.5))
				end

				Prop.Pos:SetTargets(MapVector(Prop.PosMap, vel * (-Cfg.Drag)))
				Prop.Rot:SetTargets(MapVector(Prop.RotMap, angVelLocal * Cfg.RotDrag))
			end

			for Part, Prop in pairs(PList) do
				if Prop.Type ~= "SpringRig" then continue end
				local grp = Prop.Group
				if not (grp == "Breast" or grp == "Butt") or Prop.Side ~= "Left" then continue end
				local Ptn = Prop.Partner
				if not Ptn then continue end
				local Cfg = Prop.Config

				local ownVel = Prop.Pos:GetVelocity()
				local partnerVel = Ptn.Pos:GetVelocity()

				local feed = Cfg.Coupling * n
				Prop.Pos:Impulse(partnerVel * feed)
				Ptn.Pos:Impulse(ownVel * feed)

				local sync = (partnerVel - ownVel) * (Cfg.Sync * n)
				Prop.Pos:Impulse(sync)
				Ptn.Pos:Impulse(-sync)

				local baseCF = Prop.Base.CFrame
				local aLocal = baseCF:PointToObjectSpace(Part.Position)
				local bLocal = baseCF:PointToObjectSpace(Ptn.Part.Position)
				local sep = math.abs(aLocal.X - bLocal.X)
				local thresh = (Prop.RestSep or 0.4) * Cfg.RestGapFactor
				if Cfg.RestGapFactor > 0 and sep < thresh then
					local dir = aLocal.X >= bLocal.X and 1 or -1
					local push = (thresh - sep) * Cfg.Repulse * n
					Prop.Pos:Impulse(Vector3.new(dir * push, 0, 0))
					Ptn.Pos:Impulse(Vector3.new(-dir * push, 0, 0))
				end
			end

			for Part, Prop in pairs(PList) do
				if Prop.Type ~= "SpringRig" then continue end
				local Cfg = Prop.Config

				local pos = ClampVector(Prop.Pos:Get() * Cfg.AxisGain, Cfg.MaxOffset)
				local rot = ClampVector(Prop.Rot:Get() * Cfg.RotAxisGain, Cfg.MaxRotation)
				local jig = Prop.Jig and ClampVector(Prop.Jig:Get() * Cfg.AxisGain * 0.4, Cfg.MaxOffset * 0.5) or Vector3.new()

				Prop.Weld.C0 = Prop.CF
					* CFrame.new(pos + jig)
					* CFrame.fromEulerAnglesXYZ(rot.X, rot.Y, -rot.Z)

				local speed = Prop.Pos:GetVelocity().Magnitude
				local stretch = 1 + math.clamp(
					pos.Magnitude * Cfg.Squash * 2.2 + speed * Cfg.Squash * 0.12,
					-0.18, 0.24
				)
				local inv = 1 / math.sqrt(math.max(stretch, 0.35))
				local goal = Vector3.new(stretch, inv, inv)
				Prop.CurrentScale = Prop.CurrentScale:Lerp(goal, 0.2)
				Part.Size = Prop.RestSize * Prop.CurrentScale
			end
		end
	end)




	local currentMorph = 1
	game:GetService("UserInputService").InputBegan:Connect(function(input,gpe)
		if not gpe then
			if input.KeyCode == Enum.KeyCode.C then
				PlayerData[Player.Name].UVToggle = not PlayerData[Player.Name].UVToggle
				Function.CharacterExecute(Player.Character, Player.Name)
				warn("Toggled UV")
			end
			if input.KeyCode == Enum.KeyCode.RightBracket then
				PlayerData[Player.Name].BreastsScale = PlayerData[Player.Name].BreastsScale+ 0.2
				warn("Breasts set to "..	PlayerData[Player.Name].BreastsScale)
				PlayerData[Player.Name].ButtsScale = PlayerData[Player.Name].ButtsScale+ 5
				warn("Butts set to "..	PlayerData[Player.Name].ButtsScale)
				Function.CharacterExecute(Player.Character, Player.Name)
			end
			if input.KeyCode == Enum.KeyCode.LeftBracket then
				PlayerData[Player.Name].BreastsScale = PlayerData[Player.Name].BreastsScale- 0.2
				warn("Breasts set to "..	PlayerData[Player.Name].BreastsScale)
				PlayerData[Player.Name].ButtsScale = PlayerData[Player.Name].ButtsScale- 5
				warn("Butts set to "..	PlayerData[Player.Name].ButtsScale)
				Function.CharacterExecute(Player.Character, Player.Name)
			end
			if input.KeyCode == Enum.KeyCode.B then
				for i,v in pairs(Players:GetPlayers()) do
					Function.CharacterExecute(v.Character,v.Name)
				end
			end
			if input.KeyCode == Enum.KeyCode.P then
				local partList = Function.PartListDefault()
				local keys = {}
				for k in pairs(partList) do
					table.insert(keys, k)
				end
				currentMorph+=1
				if currentMorph > #keys then currentMorph = 1 end
				
				local morph = keys[currentMorph]
				for _, player in ipairs(Players:GetPlayers()) do
					task.spawn(function()
						PlayerData[player.Name]["SelectedMorph"] = Function.PartListDefault()[morph]
						Function.CharacterExecute(player.Character, player.Name)
						warn("Morph changed to " ..morph)
						
					end)
				end
			end
			if input.KeyCode == Enum.KeyCode.Equals then
				local playerMouse = Player:GetMouse()
				local highlight = Instance.new("Highlight")
				local lastModel = nil 

				local function updateHighlight()
					local target = playerMouse.Target
					local model = target and target:FindFirstAncestorOfClass("Model")
					if model ~= lastModel then
						lastModel = model
						highlight.Parent = nil 
						if model and model:FindFirstChildOfClass("Humanoid") then
							highlight.Parent = model
						end
					end
				end

				local updateConn = RunService.RenderStepped:Connect(updateHighlight)
				local clickConn = nil
				clickConn = playerMouse.Button1Down:Connect(function()
					local selectedCharacter = highlight.Parent 
					if selectedCharacter then
						Function.CharacterExecute(selectedCharacter, selectedCharacter.Name)
					end
					updateConn:Disconnect() 
					clickConn:Disconnect()
					highlight:Destroy() 
				end)
			end


		end
	end)

	local TextChatService = game:GetService("TextChatService")
	TextChatService.MessageReceived:Connect(function(TextChatMessage)
		local Player = TextChatMessage.TextSource
		local Command = TextChatMessage.Text
		Command = string.split(Command, " ")
		if Command[1] == "/execute" then
			Function.CharacterExecute(workspace:FindFirstChild(Command[2]),Command[2])
		end
	end)

end

task.wait(1)
