	function Function.SpringCreate(Object, Base, Data, Side, Group, Config, Mapping)
		local Weld = Object:FindFirstChildOfClass("Motor6D")
		if not Weld then return end

		local RotMap = Mapping.RotationOffset or { X = "X", Y = "Y", Z = "Z" }
		if Object:GetAttribute("PhysicsRotationOffset") ~= nil then
			RotMap = Function.StringtoTable(Object:GetAttribute("PhysicsRotationOffset"))
		end

		PlayerData[Data].CurrentPartList.BodyPartPhysics[Object] = {
			Type = "SpringRig",
			Group = Group,          
			Side = Side,            
			Partner = nil,          
			Part = Object,
			Base = Base,
			Weld = Weld,
			CF = Weld.C0,           
			CF1 = Weld.C1,
			RestSize = Object.Size, 
			Pos = SpringSet.new(Config.Speed, Config.Damper),
			Rot = SpringSet.new(Config.RotSpeed, Config.RotDamper),
			Jig = Config.Jiggle and Config.Jiggle > 0 and SpringSet.new(
				{ Config.JigSpeed, Config.JigSpeed, Config.JigSpeed },
				{ Config.JigDamper, Config.JigDamper, Config.JigDamper }
			) or nil,
			PosMap = Mapping.PositionOffset or { X = "X", Y = "Y", Z = "Z" },
			RotMap = RotMap,
			CurrentScale = Vector3.new(1, 1, 1),
			Config = Config,
		}
	end

	function Function.CFrameMultiply(CF, Multiply)
		return CFrame.new(
			CF.Position.X * Multiply.X,
			CF.Position.Y * Multiply.Y,
			CF.Position.Z * Multiply.Z
		) * CF.Rotation
	end

	function Function.Vector3Multiply(Vector, Multiply)
		return Vector3.new(
			Vector.X * Multiply.X,
			Vector.Y * Multiply.Y,
			Vector.Z * Multiply.Z
		)
	end

	function Function.CompareVector3(Vector1, Vector2)
