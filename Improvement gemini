	function Function.BreastPhysics(ObjectInstance, Character, Extra, Data)
		if not PlayerData[Data].BodyPartPhysics or PlayerData[Data].UVToggle then return end
		local Torso = Character:FindFirstChild("Torso")
		if not Torso then return end

		local name = ObjectInstance.Name:lower()
		local side = name:find("left") and "Left" or "Right"
		local variance = (side == "Left" and -1 or 1) * PhysicsConfig.Breast.Variance
		local cfg = VaryCfg(PhysicsConfig.Breast, variance)

		Function.SpringCreate(ObjectInstance, Torso, Data, side, "Breast", cfg, {
